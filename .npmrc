# pnpm 11+ supply-chain hardening. See docs/dependency-vet.md for the reasoning.

# 24-hour quarantine on newly published packages. npm has no equivalent; this single
# line would have blocked both the TanStack and SAP CAP attacks, each of which was
# pulled within ~4 hours of publication. It rejected @types/node@22.20.2 (2.6h old)
# during this project's first vet.
minimumReleaseAge=1440

# Refuse git/tarball transitive dependencies — the "hidden payload in a subdep" vector.
blockExoticSubdeps=true

# `pnpm add` writes an exact version, never a caret range.
save-exact=true
